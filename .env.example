# Configuration n8n Datatable (à configurer dans Netlify > Site > Environment variables)
# URL du webhook n8n pour stocker les préférences dans un datatable
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/votre-webhook-id

# Mot de passe d'authentification pour le webhook n8n (Basic Auth, user: n8n)
N8N_AUTH_PASSWORD=votre-mot-de-passe
